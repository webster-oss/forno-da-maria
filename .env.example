# Exemplo de variaveis. Configure no ambiente; nao ha carregamento automatico.
# Desenvolvimento local nao exige configurar estas variaveis.
# Producao exige DEBUG=false, chave exclusiva e dominio correto.
DEBUG=false
SECRET_KEY=gere_uma_chave_longa_exclusiva_no_servidor
ALLOWED_HOSTS=padaria.seu-dominio.com
CSRF_TRUSTED_ORIGINS=https://padaria.seu-dominio.com
# Opcional: banco SQLite em volume persistente.
# DATABASE_PATH=/var/lib/padaria/db.sqlite3
